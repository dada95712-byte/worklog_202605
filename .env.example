# AI Provider — OpenRouter (統一入口，支援免費模型)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# 主要 model: openrouter/free（自動路由）
# 備援 model: meta-llama/llama-3.3-70b-instruct:free
# 圖片辨識: meta-llama/llama-3.2-11b-vision-instruct:free

# Vercel Blob (圖片儲存 — 本機開發自動降級為 base64)
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Job Search APIs
SERPER_API_KEY=          # https://serper.dev (免費 2,500次/月)
JSEARCH_API_KEY=         # https://rapidapi.com/letscrape-6bfed1765d1a6/api/jsearch

# Database
DATABASE_URL=            # Neon.tech 連線字串（程式碼使用 @prisma/adapter-neon serverless driver，非標準 TCP，暫不支援 Supabase 等其他 provider）

# Auth (NextAuth)
NEXTAUTH_SECRET=         # openssl rand -base64 32
NEXTAUTH_URL=            # http://localhost:3000 (開發) or https://your-app.vercel.app (生產)
GOOGLE_CLIENT_ID=        # https://console.cloud.google.com
GOOGLE_CLIENT_SECRET=    # https://console.cloud.google.com
