generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  plan          String    @default("free")
  locale        String    @default("zh-TW")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  onboardingCompleted Boolean @default(false)

  accounts        Account[]
  sessions        Session[]
  resumes         Resume[]
  userSkills      UserSkill[]
  skillEvidence   SkillEvidence[]
  careerInsights      CareerInsight[]
  careerInsightEvidence CareerInsightEvidence[]
  experiences     Experience[]
  jobApplications JobApplication[]
  interviewQAs    InterviewQA[]
  learningGoals   LearningGoal[]
  chatSessions      ChatSession[]
  interviewSessions InterviewSession[]
  workJournals      WorkJournal[]
  dailyProgress     DailyProgress[]
  resumeScores      ResumeScore[]
  careerAchievements CareerAchievement[]

  // Profile sections
  profileBasic        ProfileBasic?
  profileEducations   ProfileEducation[]
  profileExperiences  ProfileExperience[]
  profileInternships  ProfileInternship[]
  profileProjects     ProfileProject[]
  profileLanguages    ProfileLanguage[]
  profileCertificates ProfileCertificate[]
  profileActivities   ProfileActivity[]
  profileConferences  ProfileConference[]
  profileCustoms      ProfileCustom[]
  profileAttachments  ProfileAttachment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id                String    @id @default(cuid())
  userId            String
  title             String
  contentJson       Json?
  rawText           String?   @db.Text
  fileUrl           String?
  aiScore           Int?
  atsScore          Int?
  scoredAt          DateTime?
  language          String    @default("zh-TW")
  isPrimary         Boolean   @default(false)
  source            String?
  resumeType        String?
  linkedJobCompany  String?
  linkedJobTitle    String?
  jdMatchHighlights Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores            ResumeScore[]
}

// AI 評分歷史紀錄 —— 每次評分附完整細項與建議，取最新一筆做常駐顯示
model ResumeScore {
  id           String   @id @default(cuid())
  userId       String
  resumeId     String
  scoreOverall Int
  scoreContent Int
  scoreAts     Int
  scoreKeyword Int
  scoreFormat  Int
  scoreImpact  Int
  suggestions  Json?
  keywords     Json?
  language     String   @default("zh-TW")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

// 技能主檔 —— 取代舊的 Skill + ProfileSkill，個人檔案庫手填與日誌萃取共用同一份
model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  skillName   String
  category    String   @default("專業技能")
  source      String   @default("manual") // manual | verbatim | evidence | inference
  isManual    Boolean  @default(false)
  isConfirmed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence    SkillEvidence[]

  @@unique([userId, skillName])
  @@index([userId])
}

// 技能的日誌證據 —— 每筆技能對應到具體的日誌逐字摘錄，出現頻率 = COUNT(*) 而非 AI 產生
model SkillEvidence {
  id               String   @id @default(cuid())
  userId           String
  skillId          String
  journalId        String
  evidenceExcerpt  String   @db.Text
  createdAt        DateTime @default(now())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill            UserSkill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  journal          WorkJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([skillId, journalId])
  @@index([userId])
}

// 職涯洞察 —— 對行為模式的觀察，不是技能，不參與履歷生成，跟 UserSkill 完全獨立
model CareerInsight {
  id           String   @id @default(cuid())
  userId       String
  insightText  String   @db.Text
  isConfirmed  Boolean  @default(false)
  isDismissed  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence     CareerInsightEvidence[]

  @@index([userId])
}

// 職涯洞察的日誌證據 —— 每條洞察至少3篇，任一篇比對失敗整條丟棄
model CareerInsightEvidence {
  id               String   @id @default(cuid())
  userId           String
  insightId        String
  journalId        String
  evidenceExcerpt  String   @db.Text
  createdAt        DateTime @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  insight          CareerInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  journal          WorkJournal   @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([insightId, journalId])
  @@index([userId])
}

model Experience {
  id           String    @id @default(cuid())
  userId       String
  company      String
  title        String
  startDate    DateTime?
  endDate      DateTime?
  description  String?   @db.Text
  achievements Json?
  starStories  Json?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobApplication {
  id                 String    @id @default(cuid())
  userId             String
  jobTitle           String
  company            String
  industry           String?
  jdText             String?   @db.Text
  jdFullText         String?   @db.Text
  sourceUrl          String?
  platform           String?
  sourcePlatform     String?
  status             String    @default("saved")
  matchScore         Int?
  matchedSkills      Json?
  missingSkills      Json?
  matchAnalysis      Json?
  salaryMin          Int?
  salaryMax          Int?
  location           String?
  appliedAt          DateTime?
  hrScreenAt         DateTime?
  managerInterviewAt DateTime?
  gmInterviewAt      DateTime?
  offerAt            DateTime?
  deadline           DateTime?
  notes              String?   @db.Text
  interviewNotes     Json?
  attachments        Json?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  linkedResumeId     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewQAs       InterviewQA[]
}

model InterviewQA {
  id             String         @id @default(cuid())
  userId         String
  jobAppId       String?
  question       String         @db.Text
  questionType   String         @default("behavioral")
  userAnswer     String?        @db.Text
  aiFeedback     String?        @db.Text
  aiScore        Int?
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplication JobApplication? @relation(fields: [jobAppId], references: [id])
}

model LearningGoal {
  id           String    @id @default(cuid())
  userId       String
  skillName    String
  resourceUrl  String?
  resourceName String?
  status       String    @default("planned")
  targetDate   DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  context   String?
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id        String   @id @default(uuid())
  userId    String
  jobTitle  String
  company   String?
  language  String   @default("zh-TW")
  questions Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyProgress {
  id        String   @id @default(cuid())
  userId    String
  date      String
  taskIds   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model WorkJournal {
  id        String   @id @default(cuid())
  userId    String
  title     String
  company   String?
  jobTitle  String?  @db.VarChar(255)
  date      DateTime
  template  String   @default("free")
  situation String?  @db.Text
  task      String?  @db.Text
  action    String?  @db.Text
  result    String?  @db.Text
  content   String?  @db.Text
  tags      Json     @default("[]")
  images    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements CareerAchievement[]
  skillEvidence SkillEvidence[]
  careerInsightEvidence CareerInsightEvidence[]
}

// AI 從日誌萃取的量化成就 —— 待確認/已確認狀態追蹤，只有已確認的才進職涯成就總覽
model CareerAchievement {
  id             String   @id @default(cuid())
  userId         String
  journalId      String?
  company        String?
  text           String   @db.Text
  metric         String?
  journalExcerpt String?  @db.Text
  isConfirmed    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal        WorkJournal? @relation(fields: [journalId], references: [id], onDelete: SetNull)

  @@index([userId, isConfirmed])
}

// ── Profile Section Models ─────────────────────────────────────────────────────

model ProfileBasic {
  id           String   @id @default(cuid())
  userId       String   @unique
  nameZh       String?
  nameEn       String?
  email        String?
  phone        String?
  address      String?
  linkedinUrl  String?
  portfolioUrl String?
  websiteUrl   String?
  summaryZh    String?  @db.Text
  summaryEn    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_basic")
}

model ProfileEducation {
  id           String   @id @default(cuid())
  userId       String
  schoolName   String
  schoolNameEn String?
  degree      String?
  major       String?
  gpa         String?
  startDate   String?
  endDate     String?
  isCurrent   Boolean  @default(false)
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_education")
}

model ProfileExperience {
  id          String   @id @default(cuid())
  userId      String
  company     String
  companyEn   String?
  title       String?
  titleEn     String?
  location    String?
  startDate   String?
  endDate     String?
  isCurrent   Boolean  @default(false)
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_experience")
}

model ProfileInternship {
  id          String   @id @default(cuid())
  userId      String
  company     String
  companyEn   String?
  title       String?
  titleEn     String?
  location    String?
  startDate   String?
  endDate     String?
  isCurrent   Boolean  @default(false)
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_internship")
}

model ProfileProject {
  id            String   @id @default(cuid())
  userId        String
  projectName   String
  projectNameEn String?
  role          String?
  roleEn        String?
  url           String?
  startDate   String?
  endDate     String?
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_project")
}

model ProfileLanguage {
  id          String   @id @default(cuid())
  userId      String
  language    String
  proficiency String   @default("intermediate")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_language")
}

model ProfileCertificate {
  id            String   @id @default(cuid())
  userId        String
  name          String
  issuer        String?
  issueDate     String?
  expiryDate    String?
  credentialUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_certificate")
}

model ProfileActivity {
  id           String   @id @default(cuid())
  userId       String
  organization String
  role         String?
  startDate    String?
  endDate      String?
  description  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_activity")
}

model ProfileConference {
  id          String   @id @default(cuid())
  userId      String
  name        String
  role        String   @default("attendee")
  date        String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_conference")
}

model ProfileCustom {
  id           String   @id @default(cuid())
  userId       String
  sectionTitle String
  content      String?  @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_custom")
}

model ProfileAttachment {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  fileUrl     String
  fileType    String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profile_attachment")
}
